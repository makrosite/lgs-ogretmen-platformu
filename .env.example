# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=lgs_gizli_sifre_degistir
POSTGRES_DB=lgs_db

# Next.js (container içi DB bağlantısı otomatik — bunu değiştirme)
DATABASE_URL=postgresql://postgres:lgs_gizli_sifre_degistir@postgresql:5432/lgs_db

# NextAuth — openssl rand -base64 32 ile üret
NEXTAUTH_SECRET=BURAYA_32_KARAKTER_RASTGELE_YAZ
NEXTAUTH_URL=http://localhost

# JWT (öğrenci/veli linkler için) — openssl rand -base64 32 ile üret
JWT_SECRET=BURAYA_32_KARAKTER_RASTGELE_YAZ
JWT_EXPIRES_IN=48h

# Public URL (dış erişim varsa IP veya domain yaz)
NEXT_PUBLIC_APP_URL=http://localhost

# Uygulama portu (varsayılan 80)
PORT=80
